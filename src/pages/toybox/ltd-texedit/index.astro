---
import ToyboxLayout from "../../../layouts/ToyboxLayout.astro"
---

<ToyboxLayout
	title="k8's corner - toybox/ltd texture editor"
	description="edit ugc textures from tomodachi life: living the dream"
>
	<p>
		so far it can only load the image Lmfao I'll add the actual editing part
		later maybe possibly 😭
	</p>
	<div
		style="display: flex; justify-content: center; align-items: center; padding: 1em;"
	>
		<canvas
			id="texture-canvas"
			style="size: 512px !important; height: 512px !important; aspect-ratio: 1/1; image-rendering: pixelated; display: block;"
			class="border"
		>
		</canvas>
	</div>

	<p>DOOHICKEY STATUS: <span id="status">Warming up...</span></p>

	<label for="file-input">upload a .canvas.zs file here</label>
	<input type="file" id="file-input" accept=".zs" />
	<hr />
	<button class="card" id="reload">Reload image</button>
	<hr />
	<button class="card" id="export">Export image to .canvas.zs...</button>
	<button class="card" id="export-canvas">Export image to .canvas...</button>
	<hr />
	<label for="img-import">import an image file here</label>
	<input type="file" id="image-input" accept=".png" />
	<hr />
	<form>
		<label for="swizzle-mode">Swizzle mode (4 for full canvases)</label>
		<input
			type="range"
			id="swizzle-mode"
			name="swizzle-mode"
			min="0"
			max="10"
			value="4"
			oninput="this.nextElementSibling.value = this.value"
		/>
		<output>4</output>

		<br />

		<label for="width">Width</label>
		<input
			type="number"
			id="width"
			name="width"
			min="2"
			max="1024"
			value="256"
			placeholder="256"
		/>

		<br />

		<label for="height">Height</label>
		<input
			type="number"
			id="height"
			name="height"
			min="2"
			max="1024"
			value="256"
			placeholder="256"
		/>
		<br />

		<label for="width">Block Width</label>
		<input
			type="number"
			id="block-width"
			name="block-width"
			min="1"
			max="1024"
			value="1"
			placeholder="1"
		/>

		<br />

		<label for="height">Block Height</label>
		<input
			type="number"
			id="block-height"
			name="block-height"
			min="1"
			max="1024"
			value="1"
			placeholder="1"
		/>
		<br />

		<label for="height">Bytes per block</label>
		<input
			type="number"
			id="bytes-per-block"
			name="bytes-per-block"
			min="1"
			value="4"
			placeholder="4"
		/>
		<br />
		<select id="mode" name="mode">
			<option value="rgba">RGBA8 (for canvases)</option>
			<option value="bc1">BC1 (for food and treasure)</option>
			<option value="bc3">BC3 (for thumbs)</option>
		</select>
		<br />
		<button class="card" type="submit">OK</button>
	</form>

	<h1>general info about this tool</h1>
	<p>
		tomodachi life generates 3 different formats of images for the different
		kinds of UGC textures you can create in the palette house and the mii face
		paint editor. they are compressed with zstd when stored to disk. they are as
		follows:
	</p>
	<ul>
		<li>256x256 RGBA <span>.canvas</span> files for most things</li>
		<li>
			512x512 BC1 compressed <span>.ugctex</span> files for most things, always decompresses
			to 131072 bytes, block size 16
		</li>
		<li>
			384x384 BC1 for food for some reason?? always decompresses to 98304 bytes,
			block size 16
		</li>
		<li>
			256x256 BC3 compressed <span>_Thumb_ugctex</span> files for thumbnails in menus,
			always decompresses to 65536 bytes, block size 8
		</li>
	</ul>
	<p>
		if i ever decide to improve this tool, i'll probably add presets for these
		later
	</p>
	<p>
		these images can be easily decoded, this tool using a modified version of <a
			target="_blank"
			href="https://github.com/photopea/UTEX.js">UTEX.js</a
		> to decompress BC1 and BC3. however, these images are swizzled to make them more
		performant to render on the switch's GPU, which is where <a
			target="_blank"
			href="https://github.com/Aclios/pyswizzle">pyswizzle</a
		> comes into play. translating this into JS allows us to deswizzle the image and
		get the original content back.
	</p>
	<p>
		PS: tomodachi life also stores the colors as linear RGB, so color correction
		will need to be added in the future
	</p>
	<hr />

	<p>
		"Tomodachi Life" is a registered trademark of Nintendo Co., Ltd, which is
		not affiliated with, and does not endorse, this tool or website.
	</p>

	<p>
		Based on the work of Aclios' <a
			target="_blank"
			href="https://github.com/Aclios/pyswizzle">pyswizzle</a
		>
	</p>
	<p>
		This tool used a modified version of <a
			target="_blank"
			href="https://github.com/photopea/UTEX.js">UTEX.js</a
		>
	</p>
	<p>all processing in this tool is done locally! go javascript!</p>

	<script>
		// @ts-nocheck
		import { ZstdInit } from "@oneidentity/zstd-js"
		import { BytesDeswizzle, BytesSwizzle } from "./swizzler.js"
		import { Image } from "astro:assets"
		import { readBC1, readBC3, writeBC1, writeBC3 } from "./utex.js"

		const canvas = document.getElementById("texture-canvas")
		const uploader = document.getElementById("file-input")
		const importer = document.getElementById("image-input")
		const ctx = canvas.getContext("2d", { alpha: false })
		const status = document.getElementById("status")

		var width = 256
		var height = 256
		var blockSize = [1, 1]
		var bytesPerBlock = 4
		var swizzleMode = 4
		var mode = "rgba"

		let lastCanvas = undefined

		const form = document.querySelector("form")

		function reloadCanvas() {
			try {
				status.innerText = "Reloading canvas"
				loadCanvas(lastCanvas)
			} catch (e) {
				console.error("Reloading canvas failed:", e.stack)
				status.innerText = "Reloading canvas failed: " + e.message
			}
		}

		function loadCanvas(decompressedBytes) {
			canvas.width = width
			canvas.height = height

			status.innerText = "Deswizzling"

			const deswizzler = new BytesDeswizzle(
				decompressedBytes,
				[width, height],
				blockSize,
				bytesPerBlock,
				swizzleMode,
			)

			const deswizzledRaw = deswizzler.deswizzle()

			status.innerText = "Decompressing image"
			let decompressed = new Uint8Array(4 * width * height)

			if (mode == "bc1") {
				readBC1(deswizzledRaw, 0, decompressed, width, height)
			} else if (mode == "bc3") {
				readBC3(deswizzledRaw, 0, decompressed, width, height)
			} else {
				decompressed = deswizzledRaw
			}

			// Final render
			status.innerText = "Drawing"
			const clampedArray = new Uint8ClampedArray(decompressed)
			console.log(
				width,
				height,
				clampedArray.length,
				clampedArray,
				4 * width * height,
				mode,
				decompressed,
			)
			const imageData = new ImageData(clampedArray, width, height)
			ctx.clearRect(0, 0, canvas.width, canvas.height)
			ctx.putImageData(imageData, 0, 0)
			status.innerText = "Done!"
		}

		function importImage(imageFile) {
			const img = new window.Image() // tries to use astro's Image component if we don't do this
			img.src = URL.createObjectURL(imageFile)

			img.onload = function () {
				canvas.width = width
				canvas.height = height
				ctx.clearRect(0, 0, canvas.width, canvas.height)
				ctx.drawImage(img, 0, 0, canvas.width, canvas.height)
				URL.revokeObjectURL(img.src)
			}
		}

		status.innerText = "Initalizing zstd"
		ZstdInit().then(({ ZstdSimple, ZstdStream }: ZstdCodec) => {
			status.innerText = "ok <3"

			function exportCanvas(compressed) {
				try {
					const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height)
					const bytes = imageData.data
					var compressed = new Uint8Array(131072)
					if (mode == "bc1") {
						console.log("compressing bc1")
						writeBC1(bytes, width, height, compressed, 0)
					} else if (mode == "bc3") {
						console.log("compressing bc3")
						writeBC3(bytes, width, height, compressed, 0)
					} else {
						compressed = bytes
					}

					const swizzler = new BytesSwizzle(
						compressed,
						[width, height],
						blockSize,
						bytesPerBlock,
						swizzleMode,
					)
					const swizzled = swizzler.swizzle()
					const file = new Blob(
						[compressed ? ZstdStream.compress(swizzled, 19) : swizzled],
						{
							type: "application/zstd",
						},
					)
					const a = document.createElement("a")

					a.href = URL.createObjectURL(file)
					a.download = uploader.files[0]
						? uploader.files[0].name
						: compressed
							? "untitled.canvas.zs"
							: "untitled.canvas"

					a.click()

					URL.revokeObjectURL(a.href)
				} catch (e) {
					console.error("Exporting canvas failed:", e.stack)
					status.innerText = "Exporting canvas failed: " + e.message
				}
			}

			uploader.addEventListener("change", async (event) => {
				const file = event.target.files[0]
				if (!file) return
				try {
					status.innerText = "Reading in file"
					const buffer = await file.arrayBuffer()
					status.innerText = "Decompressing canvas"
					const decompressed = ZstdStream.decompress(new Uint8Array(buffer))
					lastCanvas = decompressed
					loadCanvas(decompressed)
				} catch (e) {
					console.error("Loading canvas failed:", e.stack)
					status.innerText = "Loading canvas failed: " + e.message
				}
			})

			importer.addEventListener("change", async (event) => {
				const file = event.target.files[0]
				if (!file) return
				try {
					importImage(file)
				} catch (e) {
					console.error("Importing image failed:", e.stack)
					status.innerText = "Importing image failed: " + e.message
				}
			})

			document.getElementById("reload").onclick = reloadCanvas
			document.getElementById("export").onclick = () => {
				exportCanvas(true)
			}
			document.getElementById("export-canvas").onclick = exportCanvas

			if (form) {
				form.addEventListener("submit", (event) => {
					event.preventDefault()
					console.log(form.elements)
					width = form.elements["width"].value
					height = form.elements["height"].value
					blockSize = [
						form.elements["block-width"].value,
						form.elements["block-height"].value,
					]
					bytesPerBlock = form.elements["bytes-per-block"].value
					swizzleMode = form.elements["swizzle-mode"].value
					mode = form.elements["mode"].value
					status.innerText = "Reconfigured"
					canvas.width = width
					canvas.height = height
				})
			}
		})
	</script>
</ToyboxLayout>
